px 0}.muted{background:var(--soft)}.section-head{display:flex;justify-content:space-between;align-items:end;gap:20px;margin-bottom:28px}.feature-grid,.kit-grid,.three-up,.contact-grid,.product-grid,.tool-workspace,.generator-grid{display:grid;gap:18px}.feature-grid,.kit-grid{grid-template-columns:repeat(2,1fr)}.three-up{grid-template-columns:repeat(3,1fr)}.contact-grid,.product-grid,.tool-workspace,.generator-grid{grid-template-columns:1fr 1fr}.feature-card:hover,.kit-card:hover{transform:translateY(-3px);border-color:#aaa}.feature-card,.kit-card{transition:.2s}.feature-card p,.kit-card p{color:var(--muted)}.feature-card ul,.kit-card ul{color:var(--muted);padding-left:20px}.page-hero{padding:80px 0 60px;border-bottom:1px solid var(--border)}.page-hero h1{max-width:900px}.price{font-size:32px;font-weight:850;display:block;margin:15px 0}.info-card,.form-card{margin-top:18px}.form-card form{display:grid;gap:10px}.form-card label,.controls label{font-size:14px;font-weight:700}.form-card input,.form-card select,.form-card textarea,.tool-panel textarea{width:100%;padding:13px;border:1px solid var(--border);border-radius:10px;background:#fff}.tool-panel textarea{resize:vertical}.panel-head{display:flex;justify-content:space-between;align-items:center}.small-button{border:1px solid var(--border);background:#fff;padding:7px 10px;border-radius:8px;cursor:pointer}.tool-options{display:flex;gap:18px;flex-wrap:wrap;margin:12px 0}.controls label{display:block;margin-bottom:22px}.controls output{float:right}.controls input[type=range]{width:100%}.glass-stage{min-height:400px;border-radius:18px;background:linear-gradient(135deg,#172033,#59657c);display:grid;place-items:center}.glass-preview{width:min(80%,380px);padding:30px;border-radius:20px;border:1px solid rgba(255,255,255,.25);color:#fff}.glass-preview p{color:#ddd}.code-panel{margin-top:18px;background:#151515;color:#eee;padding:20px;border-radius:14px}.code-panel pre{white-space:pre-wrap}.big-list{list-style:none;padding:0}.big-list li{padding:18px 0;border-top:1px solid var(--border)}.big-list span{display:block;color:var(--muted)}.purchase-card{height:max-content}.cta{text-align:center;max-width:780px}.site-footer{padding:50px 0 25px;border-top:1px solid var(--border)}.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr;gap:30px}.footer-grid>div{display:flex;flex-direction:column;gap:8px}.footer-bottom{border-top:1px solid var(--border);margin-top:35px;padding-top:18px;color:#777;font-size:13px}.donation-overlay{position:fixed;inset:0;z-index:999;background:#0009;display:grid;place-items:center;padding:20px;opacity:0;visibility:hidden;transition:.25s}.donation-overlay.is-visible{opacity:1;visibility:visible}.donation-modal{position:relative;width:min(500px,100%);padding:35px;background:#fff;border-radius:20px}.donation-close{position:absolute;right:14px;top:10px;border:0;background:none;font-size:28px;cursor:pointer}.donation-actions{display:grid;gap:10px;margin-top:20px}.donation-button{width:100%}.donation-later{border:0;background:none;color:#666;cursor:pointer}.modal-open{overflow:hidden}.narrow{max-width:820px}.legal-content h2{margin-top:38px}@media(max-width:900px){.hero-grid,.contact-grid,.product-grid,.tool-workspace,.generator-grid{grid-template-columns:1fr}.feature-grid,.kit-grid{grid-template-columns:1fr}.three-up{grid-template-columns:1fr 1fr}}@media(max-width:700px){.container{width:calc(100% - 28px)}.menu-toggle{display:block}.main-nav{position:absolute;display:none;top:65px;left:14px;right:14px;padding:15px;flex-direction:column;background:#fff;border:1px solid var(--border);border-radius:14px}.main-nav.open{display:flex}.hero{padding:65px 0}.section{padding:60px 0}.section-head{flex-direction:column;align-items:start}.three-up,.footer-grid{grid-template-columns:1fr}.actions .btn{width:100%}}
